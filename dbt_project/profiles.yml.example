# Copy this file as ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR)
# and adjust the values according to .env if you changed them.
#
# The host can be configured via the DBT_HOST environment variable:
# - locally (outside Docker)          -> DBT_HOST not set, "localhost" will be used
# - inside the Airflow container      -> DBT_HOST=postgres (the service name in docker-compose)



loan_pipeline:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_HOST', 'localhost') }}"
      port: 5432
      user: dwh_user
      password: dwh_password
      dbname: loan_dwh
      schema: dbt_dev
      threads: 4
